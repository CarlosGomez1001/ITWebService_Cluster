# =============================================================================
# IT Web Service Cluster - Environment Configuration
# Copy this file to .env and customize values
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=production
# NODE_ENV=development

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
# Backend PHP API
BACKEND_PORT=3000

# Frontend Development (Vite)
FRONTEND_DEV_PORT=5173

# Frontend Production (Nginx)
# NOTE: loopback-only port now. The public entry point (80/443) is owned by
# the standalone reverse-proxy project (../reverse-proxy), which reaches this
# service via 127.0.0.1:FRONTEND_PROD_PORT.
FRONTEND_PROD_PORT=8081

# -----------------------------------------------------------------------------
# MICROSERVICES PORTS (for future use)
# -----------------------------------------------------------------------------
# MS_AUTH_PORT=3001
# MS_NOTIFICATIONS_PORT=3002
# MS_REPORTS_PORT=3003
# MS_AI_PORT=3005

# Redis Cache
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# FRONTEND BUILD CONFIGURATION
# -----------------------------------------------------------------------------
# API URL that will be embedded in the frontend build
VITE_API_URL=http://localhost:3000/index.php

# For production, use your domain:
# VITE_API_URL=https://api.your-domain.com/index.php

# -----------------------------------------------------------------------------
# SSL/TLS CONFIGURATION (for production)
# -----------------------------------------------------------------------------
# TLS is now terminated at the standalone reverse-proxy (../reverse-proxy),
# not in this repo. See reverse-proxy/nginx/ssl/ instead.

# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=it-web-service
# DOCKER_BUILDKIT=1
