# =============================================================================
# IT Web Service Cluster - ENTORNO DE PRUEBAS (mismo servidor que producción)
# Copiar a .env en la carpeta de pruebas (p. ej. /srv/it-platform-test).
# Todo lo marcado con (!) debe ser distinto al .env de producción.
# =============================================================================

# (!) Aísla contenedores, red y volúmenes de producción
STACK_NAME=it-test
COMPOSE_PROJECT_NAME=it-test

NODE_ENV=production

# (!) Puertos loopback distintos a producción (3000/8081/3001/3002/3003/3005/27017)
BACKEND_PORT=4000
FRONTEND_DEV_PORT=5174
FRONTEND_PROD_PORT=9081
MS_FORMATSANDMAIL_PORT=4001
MS_NOTIFICATIONS_PORT=4002
MS_AUTH_PORT=4003
MS_AI_PORT=4005
MONGO_NOTIFICATIONS_PORT=27018

# (!) Secretos propios: un token de pruebas no debe validar en producción
# Generar con: openssl rand -hex 32
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_JWT_SECRET=
MONGO_NOTIFICATIONS_USER=notifications_admin
MONGO_NOTIFICATIONS_PASSWORD=

# (!) URLs que usa el NAVEGADOR, apuntando al reverse-proxy de pruebas
# (nuevo puerto o subdominio, p. ej. https://pruebas.tu-dominio:410)
VITE_API_URL=https://pruebas.your-domain.com/index.php
VITE_NOTIFICATIONS_URL=
NOTIFICATIONS_CORS_ORIGINS=https://pruebas.your-domain.com

# -----------------------------------------------------------------------------
# Recordatorio: también hay que separar los .env de cada servicio
# (services/*/.env en la copia de pruebas):
#   - Back/AuthService: SEC_KEY distinta; BD de PRUEBAS (IP_SERVER_PRUEBAS / respaldo restaurado)
#   - Back: NOTIFICATIONS_API_KEY / NOTIFICATIONS_JWT_SECRET iguales a los de arriba
#   - FormatsAndMails: SSRS_*_PRUEBAS; CORS_ORIGINS del front de pruebas
#   - ai-insights-service: MOCK_OPENAI=true para no gastar cuota
#   - Nadie debe enviar correos/notificaciones reales a clientes desde pruebas
# -----------------------------------------------------------------------------
