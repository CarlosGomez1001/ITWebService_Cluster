# =============================================================================
# IT Web Service Cluster - Environment Configuration
# Copy this file to .env and customize values
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=production
# NODE_ENV=development

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
# Backend PHP API
BACKEND_PORT=3000

# Frontend Development (Vite)
FRONTEND_DEV_PORT=5173

# Frontend Production (Nginx)
# NOTE: loopback-only port now. The public entry point (80/443) is owned by
# the standalone reverse-proxy project (../reverse-proxy), which reaches this
# service via 127.0.0.1:FRONTEND_PROD_PORT.
FRONTEND_PROD_PORT=8081

# -----------------------------------------------------------------------------
# MICROSERVICES PORTS (for future use)
# -----------------------------------------------------------------------------
# MS_AUTH_PORT=3001
# MS_NOTIFICATIONS_PORT=3002
# MS_REPORTS_PORT=3003
# MS_AI_PORT=3005

# Redis Cache
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# SECRETS (obligatorios: docker compose falla si están vacíos)
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 32
# Debe coincidir con NOTIFICATIONS_API_KEY del .env del backend (si aplica).
NOTIFICATIONS_API_KEY=

# MongoDB de notifications. Usar solo caracteres URL-safe en el password
# (va dentro de MONGO_URI). Generar con: openssl rand -hex 24
MONGO_NOTIFICATIONS_USER=notifications_admin
MONGO_NOTIFICATIONS_PASSWORD=
# MONGO_NOTIFICATIONS_PORT=27017   # Solo loopback (127.0.0.1)

# -----------------------------------------------------------------------------
# FRONTEND BUILD CONFIGURATION
# -----------------------------------------------------------------------------
# API URL que se incrusta en el bundle del frontend (frontend-prod, build time).
# Obligatoria. Es la URL que usa el NAVEGADOR, no el contenedor.
# Tras cambiarla: docker compose --profile prod up -d --build frontend-prod
VITE_API_URL=http://localhost:3000/index.php

# Para producción, usar el dominio público detrás del reverse-proxy:
# VITE_API_URL=https://api.your-domain.com/index.php

# -----------------------------------------------------------------------------
# SSL/TLS CONFIGURATION (for production)
# -----------------------------------------------------------------------------
# TLS is now terminated at the standalone reverse-proxy (../reverse-proxy),
# not in this repo. See reverse-proxy/nginx/ssl/ instead.

# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=it-web-service
# DOCKER_BUILDKIT=1
